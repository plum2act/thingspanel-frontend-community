# Debug build for frontend - preserves source maps
FROM node:20-alpine AS builder

WORKDIR /app

# 安装依赖
COPY package.json pnpm-lock.yaml ./
RUN npm install -g pnpm@8 && pnpm install

# 复制源码
COPY . .

# 构建（保留 source map）
ENV VITE_SOURCE_MAP=Y
ENV VITE_ROUTER_HISTORY_MODE=history
ENV VITE_AUTH_ROUTE_MODE=dynamic
RUN pnpm build

# 生产镜像
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080
ENTRYPOINT nginx -g "daemon off;"